    def _estimate_p_from_range_dir(
            self,
            anchors: np.ndarray,
            r: np.ndarray,
            u: np.ndarray,
            mask: np.ndarray,
            sigma_r2: np.ndarray,
            sigma_u2: np.ndarray,
            p_init: np.ndarray,
            dir_weight: float = 1.0,
    ) -> np.ndarray:
        N, M = r.shape
        p = p_init.astype(np.float32).copy()
        A = anchors.astype(np.float32)

        converged = np.zeros((N,), dtype=bool)

        I3 = np.eye(3, dtype=np.float32)

        for _ in range(self.p_isac_iters):
            all_done = True

            for i in range(N):
                if converged[i]:
                    continue

                mi = mask[i].astype(bool)
                if int(mi.sum()) < self.min_anchors_for_p_isac:
                    converged[i] = True
                    continue

                Ai = A[mi]  # (K,3)
                ri = r[i, mi].astype(np.float32)  # (K,)
                ui = u[i, mi].astype(np.float32)  # (K,3)

                wr = 1.0 / np.maximum(sigma_r2[i, mi].astype(np.float32), 1e-6)  # (K,)
                wu = dir_weight / np.maximum(sigma_u2[i, mi].astype(np.float32), 1e-6)  # (K,)

                pi = p[i].astype(np.float32)

                H = self.p_isac_lam * np.eye(3, dtype=np.float32)
                g = np.zeros((3,), dtype=np.float32)

                cost0 = 0.0

                for k in range(Ai.shape[0]):
                    ak = Ai[k]
                    rk = ri[k]
                    uk = ui[k]

                    q = ak - pi  # predicted LOS vector toward anchor
                    dk = np.linalg.norm(q) + 1e-9
                    uhat = q / dk

                    # -------------------------
                    # 1) range residual
                    # -------------------------
                    er = dk - rk  # scalar
                    Jr = -(q / dk)  # (3,)

                    H += wr[k] * np.outer(Jr, Jr)
                    g += wr[k] * Jr * er
                    cost0 += float(wr[k] * er * er)

                    # -------------------------
                    # 2) direction residual
                    # use tangent-plane residual
                    # -------------------------
                    Pk = I3 - np.outer(uk, uk)  # tangent projector at measured direction
                    eu = Pk @ (uhat - uk)  # (3,)

                    # d(uhat)/dp = -(I - uhat uhat^T)/d
                    Ju_full = -(I3 - np.outer(uhat, uhat)) / dk  # (3,3)
                    Ju = Pk @ Ju_full  # projected Jacobian

                    H += wu[k] * (Ju.T @ Ju)
                    g += wu[k] * (Ju.T @ eu)
                    cost0 += float(wu[k] * (eu @ eu))

                try:
                    dx = -np.linalg.solve(H, g).astype(np.float32)
                except np.linalg.LinAlgError:
                    all_done = False
                    continue

                n = float(np.linalg.norm(dx))
                if n > self.p_isac_step_clip:
                    dx *= self.p_isac_step_clip / (n + 1e-9)

                p_new = pi + dx

                # 重新评估代价
                cost1 = 0.0
                for k in range(Ai.shape[0]):
                    ak = Ai[k]
                    rk = ri[k]
                    uk = ui[k]

                    q = ak - p_new
                    dk = np.linalg.norm(q) + 1e-9
                    uhat = q / dk

                    er = dk - rk
                    Pk = I3 - np.outer(uk, uk)
                    eu = Pk @ (uhat - uk)

                    cost1 += float(wr[k] * er * er)
                    cost1 += float(wu[k] * (eu @ eu))

                p[i] = p_new

                if n < 1e-2:
                    converged[i] = True
                    continue

                rel_improve = abs(cost0 - cost1) / (abs(cost0) + 1e-9)
                if rel_improve < 1e-3:
                    converged[i] = True
                    continue

                all_done = False

            if all_done:
                break

        return p.astype(np.float32)


    def _build_knn(self, p_ref: np.ndarray) -> np.ndarray:
        N = int(p_ref.shape[0])
        k = min(self.k_neighbors, max(N - 1, 0))
        if k <= 0:
            return np.zeros((N, 0), dtype=np.int64)

        diff = p_ref[:, None, :] - p_ref[None, :, :]
        dist = np.linalg.norm(diff, axis=2).astype(np.float32)
        np.fill_diagonal(dist, np.inf)

        kth = max(k - 1, 0)
        return np.argpartition(dist, kth=kth, axis=1)[:, :k].astype(np.int64)

    # ========================================================
    # Neighbor & formation features
    # ========================================================
    def _compute_neighbor_features(
            self,
            gps: np.ndarray,
            p_isac: np.ndarray,
            dp: np.ndarray,
    ) -> np.ndarray:
        """
        Neighbor features (8-dim, normalized, no p_valid):

        [rel_bias_x,
         rel_bias_y,
         rel_bias_z,
         rel_bias_norm,
         pair_dist_err_mean,
         pair_dist_err_max,
         pair_bias_diff_mean,
         pair_bias_diff_max]
        """

        N = int(gps.shape[0])
        nbr_idx = self._build_knn(p_isac)

        if nbr_idx.shape[1] == 0:
            return np.zeros((N, 8), dtype=np.float32)

        eps = 1e-6
        pos_scale = max(self.pos_scale, eps)

        # =========================
        # Pairwise distance (GPS / ISAC)
        # =========================
        d_gps = np.linalg.norm(gps[:, None, :] - gps[None, :, :], axis=2)
        d_isac = np.linalg.norm(p_isac[:, None, :] - p_isac[None, :, :], axis=2)


        pair_dist_err = np.abs(d_gps - d_isac) / (pos_scale + eps)
        pair_dist_err = np.clip(pair_dist_err, 0.0, 10.0).astype(np.float32)
        np.fill_diagonal(pair_dist_err, 0.0)

        # =========================
        # Pairwise bias difference（统一尺度）
        # =========================
        pair_bias_diff = np.linalg.norm(dp[:, None, :] - dp[None, :, :], axis=2)
        # pair_bias_diff = pair_bias_diff / pos_scale
        pair_bias_diff = np.clip(pair_bias_diff, 0.0, 10.0).astype(np.float32)
        np.fill_diagonal(pair_bias_diff, 0.0)

        # =========================
        # Initialize outputs
        # =========================
        rel_b = np.zeros((N, 3), dtype=np.float32)
        pair_dist_mean = np.zeros((N, 1), dtype=np.float32)
        pair_dist_max = np.zeros((N, 1), dtype=np.float32)
        pair_bias_mean = np.zeros((N, 1), dtype=np.float32)
        pair_bias_max = np.zeros((N, 1), dtype=np.float32)

        # =========================
        # Loop per agent
        # =========================
        for i in range(N):
            idx = nbr_idx[i]
            if idx.size == 0:
                continue

            # ---------- relative bias ----------
            b_ref = np.median(dp[idx], axis=0).astype(np.float32)
            rel_b[i] = (dp[i] - b_ref).astype(np.float32)

            # ---------- pair distance ----------
            pd = pair_dist_err[i, idx]
            pair_dist_mean[i, 0] = float(np.mean(pd))
            pair_dist_max[i, 0] = float(np.max(pd))

            # ---------- pair bias ----------
            pb = pair_bias_diff[i, idx]
            pair_bias_mean[i, 0] = float(np.mean(pb))
            pair_bias_max[i, 0] = float(np.max(pb))

        # =========================
        # Relative bias norm（统一尺度）
        # =========================
        # rel_norm = np.linalg.norm(rel_b, axis=1, keepdims=True) / pos_scale

        rel_norm = np.linalg.norm(rel_b, axis=1, keepdims=True)
        rel_norm = rel_norm.astype(np.float32)

        # =========================
        # Final feature concat
        # =========================
        feats = np.concatenate(
            [
                rel_b.astype(np.float32),  # 3
                rel_norm,  # 1
                pair_dist_mean,  # 1
                pair_dist_max,  # 1
                pair_bias_mean,  # 1
                pair_bias_max,  # 1
            ],
            axis=1,
        ).astype(np.float32)

        return feats

