    def _compute_detection_reward(self, a: np.ndarray, y: np.ndarray, info: dict) -> np.ndarray:
        a = np.asarray(a, dtype=np.int32).reshape(self.N)
        y = np.asarray(y, dtype=np.int32).reshape(self.N)

        R = np.zeros((self.N,), dtype=np.float32)

        rise_true = (self._y_prevprev == 0) & (y == 1)
        fall_true = (self._y_prevprev == 1) & (y == 0)
        rise_pred = (self._a_prev == 0) & (a == 1)
        fall_pred = (self._a_prev == 1) & (a == 0)

        current_t = int(getattr(self.unwrapped_env, "t", 0))

        if np.any(rise_true):
            self._event_open[rise_true] = True
            self._detected_in_event[rise_true] = False
            t0_info = int(info.get("attack_t0_t1", (current_t, current_t))[0])
            self._event_t0[rise_true] = t0_info

        first_hit = (y == 1) & (a == 1) & (~self._detected_in_event)
        if np.any(first_hit):
            elapsed_steps = np.maximum(0, current_t - self._event_t0[first_hit])
            Td_steps = max(1, int(round(self.delay_full_seconds / max(self.dt, 1e-9))))
            delay_weight = np.exp(
                -self.delay_k * np.clip(elapsed_steps, 0, Td_steps) / float(Td_steps)
            ).astype(np.float32)
            R[first_hit] += self.R_TP * delay_weight
            self._detected_in_event[first_hit] = True

        stay = (y == 1) & (a == 1)
        if np.any(stay):
            R[stay] += self.stay_reward

        tn = (y == 0) & (a == 0)
        if np.any(tn):
            R[tn] += self.R_TN

        fp_edge = rise_pred & (y == 0)
        if np.any(fp_edge):
            idx = np.where(fp_edge)[0]
            cooldown_ok = (current_t - self._last_fp_step[idx]) >= self.fp_cooldown_steps
            penalize_idx = idx[cooldown_ok]
            if penalize_idx.size > 0:
                R[penalize_idx] -= self.R_FP
                self._last_fp_step[penalize_idx] = current_t

        hold_neg = (y == 0) & (a == 1) & (~rise_pred)
        self._neg_hold_counter[hold_neg] += 1
        self._neg_hold_counter[~hold_neg] = 0

        if self.use_cusum_in_reward and (self._cusum is not None):
            cus_norm = np.asarray(self._cusum).reshape(-1) / max(self.cusum_max, 1e-6)
            waive = (self._neg_hold_counter <= self.neg_hold_grace_steps) | (
                    cus_norm >= self.cusum_waive_threshold
            )
            apply_cost = hold_neg & (~waive)
        else:
            apply_cost = hold_neg & (self._neg_hold_counter > self.neg_hold_grace_steps)

        if np.any(apply_cost):
            R[apply_cost] -= self.hold_cost

        miss = (y == 1) & (a == 0)
        if np.any(miss):
            R[miss] -= self.fn_step_penalty

        miss_event = fall_true & self._event_open & (~self._detected_in_event)
        if np.any(miss_event):
            R[miss_event] -= self.R_FN

        if np.any(fall_true):
            self._event_open[fall_true] = False
            self._detected_in_event[fall_true] = False

        if self.hysteresis_penalty > 0.0:
            if self.use_cusum_in_reward and (self._cusum is not None):
                cus_norm = np.asarray(self._cusum).reshape(-1) / max(self.cusum_max, 1e-6)
                bad_off = fall_pred & (cus_norm >= self.cusum_waive_threshold)
            else:
                bad_off = fall_pred & (y == 1)
            if np.any(bad_off):
                R[bad_off] -= self.hysteresis_penalty

        if self.flip_penalty > 0.0:
            R -= self.flip_penalty * (a != self._a_prev).astype(np.float32)

        self._a_prev = a.copy()
        self._y_prevprev = y.copy()
        return R.astype(np.float32)

    def _init_p_isac_from_ranges(
            self,
            anchors: np.ndarray,
            r: np.ndarray,
            mask: np.ndarray,
            sigma_r2: np.ndarray,
    ) -> np.ndarray:
        N, M = r.shape
        A = anchors.astype(np.float32)
        p0 = np.zeros((N, 3), dtype=np.float32)

        global_center = np.mean(A, axis=0).astype(np.float32)

        for i in range(N):
            idx = np.where(mask[i] > 0.5)[0]
            if idx.size < self.min_anchors_for_p_isac:
                p0[i] = global_center
                continue

            # 选一个参考锚点：用测距最小的那个更稳一点
            ref = idx[np.argmin(r[i, idx])]
            others = idx[idx != ref]

            # 3D 至少需要 3 条独立方程
            if others.size < 3:
                p0[i] = np.mean(A[idx], axis=0).astype(np.float32)
                continue

            Aref = A[ref]
            rref = float(r[i, ref])

            H_list = []
            b_list = []
            w_list = []

            for k in others:
                Ak = A[k]
                rk = float(r[i, k])

                # 2 (Ak - Aref)^T p = rref^2 - rk^2 + ||Ak||^2 - ||Aref||^2
                H_list.append(2.0 * (Ak - Aref))
                b_list.append(
                    rref * rref - rk * rk
                    + float(np.dot(Ak, Ak) - np.dot(Aref, Aref))
                )

                # 简单加权
                wk = 1.0 / float(sigma_r2[i, k] + sigma_r2[i, ref] + 1e-6)
                w_list.append(wk)

            H = np.asarray(H_list, dtype=np.float32)  # (K,3)
            b = np.asarray(b_list, dtype=np.float32)  # (K,)
            W = np.diag(np.asarray(w_list, dtype=np.float32))

            try:
                lhs = H.T @ W @ H + 1e-3 * np.eye(3, dtype=np.float32)
                rhs = H.T @ W @ b
                p0[i] = np.linalg.solve(lhs, rhs).astype(np.float32)
            except np.linalg.LinAlgError:
                p0[i] = np.mean(A[idx], axis=0).astype(np.float32)

        return p0
    # ========================================================
    # Feature names
    # ========================================================
    def get_feature_names(self):
        isac_names = [
            "abs_dr_mean",
            "abs_dr_max",
            "abs_dd_mean",
            "abs_dd_max",
            "dir_err_mean",
            "dir_err_max",
            "score",
            "cusum",
            "score_delta",
            "score_std",
        ]

        self_names = [
            "dp_norm",
            "dp_proj",
        ]


        neighbor_names = [
            "rel_bias_x",
            "rel_bias_y",
            "rel_bias_z",
            "rel_bias_norm",
            "pair_dist_err_mean",
            "pair_dist_err_max",
            "pair_bias_diff_mean",
            "pair_bias_diff_max",
        ]

        formation_names = [
            "pair_err_mean",
            "pair_err_dev",
            "pair_err_delta",
            "pair_err_cusum",
        ]
        return isac_names + self_names + neighbor_names + formation_names
        # return isac_names + self_names + formation_names

